<UserControl x:Class="HydroExplorer.MVVM.View.DataGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer.MVVM.View"
             xmlns:viewModel="clr-namespace:HydroExplorer.MVVM.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >

    
    <Grid Background="#181818">
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>

        
        
        <DataGrid x:Name="dgSimple"
                  Background="Gray"
                  RowBackground="Gray"
                  AlternatingRowBackground="LightBlue"
                  AlternationCount="2"
                  FontSize="10"
                  ></DataGrid>

            <DataGrid x:Name="dgWselProfile2"
                  Grid.Row="1"
                  Background="Gray"
                  RowBackground="Gray"
                  AlternatingRowBackground="LightBlue"
                  AlternationCount="2"
                  FontSize="10"
                  ></DataGrid>

                <DataGrid x:Name="dgCompare"
                  Grid.Column="1"
                  Background="Gray"
                  RowBackground="Gray"
                  AlternatingRowBackground="LightBlue"
                  AlternationCount="2"
                  FontSize="10"
                  ></DataGrid>




