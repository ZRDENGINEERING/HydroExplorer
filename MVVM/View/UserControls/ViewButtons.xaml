<UserControl x:Class="HydroExplorer.MVVM.View.UserControls.ViewButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer.MVVM.View"
             xmlns:HydroExplorer="clr-namespace:HydroExplorer;assembly=HydroExplorer"
             xmlns:userControls="clr-namespace:HydroExplorer.MVVM.View.UserControls"
             xmlns:viewModel="clr-namespace:HydroExplorer.MVVM.ViewModels" 
             xmlns:utils="clr-namespace:HydroExplorer.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="150">

<!--
    <UserControl.DataContext>
        <viewModel:MainViewModel/>
    </UserControl.DataContext>
-->


    <Grid Background="#262626">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

                <Grid HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>



                    <RadioButton Content="PROJECTS"
                                 Grid.Row="0"
                                 Width="90"
                                 Foreground="LightGray"
                                 FontSize="12"
                                 Style="{StaticResource MenuButtonTheme}"
                                 IsChecked="True"
                                 Command="{Binding HomeViewCommand}" 
                                 />

                    <RadioButton Content="DATA GRID"
                                 Grid.Row="1"
                                 Width="90"
                                 Foreground="LightGray"
                                 FontSize="12"
                                 Style="{StaticResource MenuButtonTheme}"
                                 Command="{Binding DataGridViewCommand}"
                                 />

                    <RadioButton Content="MAPPING"
                                 Grid.Row="2"
                                 Width="90"
                                 Foreground="LightGray"
                                 FontSize="12"
                                 Style="{StaticResource MenuButtonTheme}"
                                 Command="{Binding MapViewCommand}" 
                                />

                    <StackPanel Orientation="Vertical"
                                    Grid.Row="3"
                                    Margin="10,15,0,10">

                        <TextBlock Text="Rivers"
                                Foreground="LightGray"
                                FontSize="10"
                                />

                        <TextBlock Text="Reaches"
                                HorizontalAlignment="Left"
                                Foreground="LightGray"
                                FontSize="10"
                                />

                        <TextBlock Text="Profiles"
                                Foreground="LightGray"
                                FontSize="10"
                                />

                        <TextBlock Text="Plans"
                                Foreground="LightGray"
                                FontSize="10"
                                />
                    </StackPanel>

                </Grid>
        </Grid>


</UserControl>
