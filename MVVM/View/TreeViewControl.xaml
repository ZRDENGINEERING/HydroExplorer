<UserControl x:Class="HydroExplorer.MVVM.View.TreeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:core="clr-namespace:HydroExplorer.Core" 
             xmlns:models="clr-namespace:HydroExplorer.MVVM.Models" 
             xmlns:views="clr-namespace:HydroExplorer.MVVM.ViewModels" 
             xmlns:behaviors="clr-namespace:HydroExplorer.MVVM.Behaviors"
             d:DataContext="{d:DesignInstance Type=views:MainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="150">
    
    
    <Grid>
        <TreeView x:Name="FolderView"
            Background="#262626"
                      BorderBrush="#1f1f1f"
                      ItemsSource="{Binding TreeItems}"
                      behaviors:TreeViewSelectedItemBehavior.SelectedItem="{Binding SelectedNode}">

            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground" Value="LightGray"/>
                    <Setter Property="FontSize" Value="10"/>
                    
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                    <Image Width="18" Margin="1" 
                                            Source="{Binding RelativeSource={RelativeSource 
                                                Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                                Path=Tag,
                                                Converter={x:Static local:HeaderToImageConv.Instance}}"/>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    
                </Style>
            </TreeView.Resources>
            
        </TreeView>

    </Grid>

</UserControl>
