<UserControl x:Class="HydroExplorer.View.TreeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:core="clr-namespace:HydroExplorer.Core" 
             xmlns:vm="clr-namespace:HydroExplorer.ViewModel" 
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="150">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="330" MinHeight="32"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="50"/>
        </Grid.ColumnDefinitions>


        <!-- Header -->
        <GroupBox Grid.Row="0"
                  Header="PROJECT EXPLORER"
                  FontSize="12" FontWeight="SemiBold"
                  Background="{StaticResource BackgroundBrushHeader}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8">
        </GroupBox>
        
        

        <TreeView x:Name="foldersItem"
                  Grid.Row="1"
                  SelectedItemChanged="FoldersItem_SelectedItemChanged"
                  MouseMove="FoldersItem_MouseMove"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  BorderBrush="{StaticResource BorderBrush}" 
                  BorderThickness="0.8">




            <TreeView.Resources>
                <Style TargetType="{x:Type TreeViewItem}" 
           BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="FontSize" Value="10"/>
                    <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                    <Image Width="18" Margin="1" 
                            Source="{Binding RelativeSource={RelativeSource 
                                Mode=FindAncestor, AncestorType={x:Type TreeViewItem}},
                                Path=Tag,
                                Converter={x:Static local:HeaderToImageConv.Instance}}"/>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.Resources>
        </TreeView>


        <!-- Splitter -->
        <GridSplitter Grid.Row="2" Width="400"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}"
                      ShowsPreview="False"/>



        <!-- Project Path Selections -->

        <GroupBox Grid.Row="3"
                  Header="ACTIVE PATHS" 
                  FontSize="12" FontWeight="SemiBold"
                  Foreground="{StaticResource ForegroundBrush}"
                  Background="{StaticResource BackgroundBrushLight}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8">
            <StackPanel Background="{StaticResource BackgroundBrushSidePanels}">

                
                <TextBox Name="txtBoxProjPathLbl" FontSize="10" BorderThickness="0" Margin="10,0,0,0">Proj Path:</TextBox>
                <TextBox Name="txtBoxProjPath" FontSize="8" BorderThickness="0" Width="220" HorizontalAlignment="left"
                    Foreground="{StaticResource ForegroundBrushDark}" Margin="15,0,0,0"/>

                <TextBox Name="txtBoxPlanNameLblA" FontSize="10" BorderThickness="0" Margin="10,0,0,0">Plan Name A:</TextBox>
                <ComboBox Name="cboxPlanNameA" FontSize="10" Background="#543d05" BorderThickness="0" Width="200"
                    Foreground="{StaticResource ForegroundBrushDark}" Margin="0,0,0,10"/>
                <TextBox Name="txtBoxHdfPathA" FontSize="8" IsReadOnly="True" BorderThickness="0" Width="220" HorizontalAlignment="left"
                    Foreground="{StaticResource ForegroundBrushDark}" Margin="15,0,0,0"/>

                
                
                <TextBox Name="txtBoxPlanNameLblB" FontSize="10" BorderThickness="0" Margin="10,0,0,0">Plan Name B:</TextBox>
                <ComboBox Name="cboxPlanNameB" FontSize="10" Background="#543d05" BorderThickness="0" Width="200"
                    Foreground="{StaticResource ForegroundBrushDark}" Margin="0,0,0,10"/>
                <TextBox Name="txtBoxHdfPathB" FontSize="8" IsReadOnly="True" BorderThickness="0" Width="220" HorizontalAlignment="left"
                     Foreground="{StaticResource ForegroundBrushDark}" Margin="15,0,0,0"/>


                <TextBox Name="cboxProfileLbl" FontSize="10" BorderThickness="0" Margin="10,0,0,0">Profile:</TextBox>
                <ComboBox Name="cboxProfiles" FontSize="10" Background="#543d05" BorderThickness="0" Width="200"
                    Foreground="{StaticResource ForegroundBrushDark}" Margin="0,0,0,10"/>
                <TextBox Name="txtBoxHeadHMS" FontSize="10" BorderThickness="0" Width="220" HorizontalAlignment="left"
                    Foreground="{StaticResource ForegroundBrushDark}" Margin="15,0,0,0"/>

                <TextBlock Margin="10,0,0,0"
                    Name="txtBoxHmsPathLbl" FontSize="10">HMS Path:</TextBlock>

                    <DockPanel Margin="20,0,4,4">
                        <Button DockPanel.Dock="Right"
                            Content="..."
                            Command="{Binding BrowseShpCommand}"
                            CommandParameter="Boundary"
                            Width="22" Height="20"
                            Padding="0"
                            FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                        <TextBox Text="{Binding SelectedBoundaryPath.Name, Mode=OneWay}"
                            Name="txtBoxHmsPath" 
                             FontSize="10" 
                             IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                    </DockPanel>

                
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
    
            