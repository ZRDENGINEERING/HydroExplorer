<UserControl x:Class="HydroExplorer.View.DiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewsModel="clr-namespace:HydroExplorer.ViewModel" 
             xmlns:local="clr-namespace:HydroExplorer.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#1B1B1B">


    <StackPanel>
        <TextBlock Text="Discovery"
                   Foreground="{StaticResource ForegroundBrush}"
                   Background="{StaticResource BackgroundBrushLight}"
                   FontSize="28"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,20"/>

        <StackPanel Orientation="Horizontal"
                    Margin="10,0,0,10">
            <Border Width="400"
                    Height="200">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                        <GradientStop Color="DarkBlue" Offset="0.0"/>
                        <GradientStop Color="DarkBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Clip>
                    <RectangleGeometry RadiusX="10"
                                       RadiusY="10"
                                       Rect="0,0,400,200"/>
                </Border.Clip>


                <Grid>
                    <StackPanel>
                        <TextBlock Text="Leaders in water &#x0a; resources engineering"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="28"
                                   Margin="20,10,10,0"/>
                        <TextBlock Text="Contact Us Today!"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="14"
                                   Margin="20,10,10,0"/>

                    </StackPanel>

                    <Image Width="120"
                           Height="113"
                           Source="/Images/ZRD.jpg"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="0,0,10,10"/>

                </Grid>
            </Border>
            <Border Width="200"
                    Height="200"
                    CornerRadius="5"
                    Margin="45,0,0,0">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                        <GradientStop Color="orange" Offset="0.0"/>
                        <GradientStop Color="orange" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

            </Border>

        </StackPanel>

        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Margin" Value="15,0,0,0"/>
                </Style>
            </StackPanel.Resources>

            <TextBlock Text="Most Watched"
                        Foreground="{StaticResource ForegroundBrush}"
                        FontSize="20"
                        HorizontalAlignment="Left"
                        Margin="10,0,10,0"/>

            <StackPanel Orientation="Horizontal">
                <Border Width="150"
                        Height="150"
                        Background="#844eff"
                        CornerRadius="5"/>
                <Border Width="150"
                        Height="150"
                        Background="#4e99ff"
                        CornerRadius="5"/>
                <Border Width="150"
                        Height="150"
                        Background="#4eff91"
                        CornerRadius="5"/>
                <Border Width="150"
                        Height="150"
                        Background="#ecff4e"
                        CornerRadius="5"/>
            </StackPanel>

        </StackPanel>

    </StackPanel>
</UserControl>
