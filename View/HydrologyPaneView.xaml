<UserControl x:Class="HydroExplorer.View.HydrologyPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:views="clr-namespace:HydroExplorer.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="150">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="330" MinHeight="32"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="HYDROLOGY"
                  FontSize="12" FontWeight="SemiBold"
                  Background="{StaticResource BackgroundBrushHeader}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8"/>

        <views:FilteredTreeView Grid.Row="1" FileExtensionFilter=".run"/>

        <GridSplitter Grid.Row="2" Width="400"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}"
                      ShowsPreview="False"/>

        <GroupBox Grid.Row="3"
                  Header="ACTIVE PATHS"
                  FontSize="12" FontWeight="SemiBold"
                  Foreground="{StaticResource ForegroundBrush}"
                  Background="{StaticResource BackgroundBrushLight}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8">
            <StackPanel Background="{StaticResource BackgroundBrushSidePanels}">

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">HMS Project:</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Click="BrowseHmsProject_Click"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox x:Name="txtHmsProjectPath"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">HMS Run:</TextBlock>
                <ComboBox x:Name="cboxHmsRun"
                          FontSize="10" Background="#543d05" BorderThickness="0"
                          Width="200" Margin="0,0,0,6"
                          Foreground="{StaticResource ForegroundBrushDark}"/>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">DSS File:</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Click="BrowseDss_Click"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox x:Name="txtDssFilePath"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">DSS Run:</TextBlock>
                <ComboBox x:Name="cboxDssRun"
                          FontSize="10" Background="#543d05" BorderThickness="0"
                          Width="200" Margin="0,0,0,6"
                          Foreground="{StaticResource ForegroundBrushDark}"/>

            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
