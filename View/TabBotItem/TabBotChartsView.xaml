<UserControl x:Class="HydroExplorer.View.TabBotItem.TabBotChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer.View"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <!-- Reach selector panel — auto-sized, hidden when single reach -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left plot — Charts/Info tab -->
        <oxy:PlotView Grid.Column="0"
                  Model="{Binding PlotVm.PlotModelChartsTab}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ShowLP3Plot,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Profile Plot full width — Main tab only -->
        <oxy:PlotView Grid.Column="0" Grid.ColumnSpan="3"
                  Model="{Binding PlotVm.PlotModel}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ShowProfilePlot,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Splitter between left and right plots -->
        <GridSplitter Grid.Column="1" Width="3"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource DividerBrush}"
                  Visibility="{Binding ShowLP3Plot,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- LP3 Plot -->
        <oxy:PlotView Grid.Column="2"
                  Model="{Binding LP3Vm.PlotModelLP3}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ShowLP3Plot,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Splitter before reach panel -->
        <GridSplitter Grid.Column="3" Width="3"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource DividerBrush}"
                  Visibility="{Binding PlotVm.HasMultipleReaches,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Reach selector — only visible when model has multiple reaches -->
        <Border Grid.Column="4"
                MinWidth="110"
                Background="{StaticResource BackgroundBrushSidePanels}"
                Visibility="{Binding PlotVm.HasMultipleReaches,
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Margin="6,6,6,0">
                <TextBlock Text="REACHES"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrushDark}"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding PlotVm.Reaches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Command="{Binding DataContext.PlotVm.ReachSelectionChangedCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      FontSize="9"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      Margin="0,2,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>

</UserControl>