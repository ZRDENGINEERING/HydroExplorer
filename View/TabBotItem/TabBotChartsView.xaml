<UserControl x:Class="HydroExplorer.View.TabBotItem.TabBotChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer.View.TabBotItem"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrushDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Reach checkboxes -->
            <ColumnDefinition Width="*"/>
            <!-- Plot -->
        </Grid.ColumnDefinitions>

        <!-- Reach Selector (left side, vertical stack) -->
        <Border Grid.Column="0"
                Background="#1E2A38"
                BorderBrush="#2D3E50"
                BorderThickness="0,0,1,0"
                Padding="8,10"
                Visibility="{Binding PlotVm.HasMultipleReaches, 
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Reaches:"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#A0B4C8"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding PlotVm.Reaches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,0,6"
                                      VerticalAlignment="Center"
                                      FontSize="10"
                                      Foreground="{StaticResource ForegroundBrushDark}"
                                      Command="{Binding DataContext.PlotVm.ReachSelectionChangedCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Plot -->
        <oxy:PlotView Grid.Column="1"
                      Model="{Binding PlotVm.PlotModel}"
                      BorderThickness="1"
                      Background="{StaticResource BackgroundBrushDark}"/>
    </Grid>

</UserControl>