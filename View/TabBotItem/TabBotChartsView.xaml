<UserControl x:Class="HydroExplorer.View.TabBotItem.TabBotChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer.View"
             xmlns:themes="clr-namespace:HydroExplorer.Themes"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <themes:AllTrueToVisibilityConverter x:Key="AllTrueToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3"/>
            <!-- Reach selector panel — auto-sized, hidden unless on Main tab with multiple reaches -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left plot — shared across HMS Charts (paired w/ LP3) and Info
             (paired w/ Omega): Creager envelope, half-width next to whichever
             right-side plot is active. -->
        <oxy:PlotView x:Name="CreagerPlotView"
                  Grid.Column="0"
                  Unloaded="PlotView_Unloaded"
                  Model="{Binding ViewModel.CreagerVm.PlotModelChartsTab, ElementName=Root}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ViewModel.ShowChartsRightPane, ElementName=Root,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Profile Plot — Main tab only. Spans through the reach-selector column
             too (ColumnSpan=5) so it still fills the width when there's nothing to
             select; the reach panel sits on top of/within that span when visible,
             same composition the original layout used. -->
        <oxy:PlotView x:Name="ProfilePlotView"
                  Grid.Column="0" Grid.ColumnSpan="5"
                  Unloaded="PlotView_Unloaded"
                  Model="{Binding ViewModel.PlotVm.PlotModel, ElementName=Root}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ViewModel.ShowProfilePlot, ElementName=Root,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Splitter between left and right plots -->
        <GridSplitter Grid.Column="1" Width="3"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource DividerBrush}"
                  Visibility="{Binding ViewModel.ShowChartsRightPane, ElementName=Root,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- LP3 Plot — HMS Charts bottom tab only -->
        <oxy:PlotView x:Name="LP3PlotView"
                  Grid.Column="2"
                  Unloaded="PlotView_Unloaded"
                  Model="{Binding ViewModel.LP3Vm.PlotModelLP3, ElementName=Root}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ViewModel.ShowLP3Plot, ElementName=Root,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Omega EM Plot — Info tab bottom chart, right side, only -->
        <oxy:PlotView x:Name="OmegaPlotView"
                  Grid.Column="2"
                  Unloaded="PlotView_Unloaded"
                  Model="{Binding ViewModel.OmegaVm.PlotModelOmegaEm, ElementName=Root}"
                  Background="{StaticResource BackgroundBrushSidePanels}"
                  Visibility="{Binding ViewModel.ShowOmegaPlot, ElementName=Root,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Splitter before reach panel — only relevant on the Main tab, where the
             profile plot's reach selector lives. -->
        <GridSplitter Grid.Column="3" Width="3"
                  HorizontalAlignment="Stretch"
                  Background="{StaticResource DividerBrush}">
            <GridSplitter.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                    <Binding Path="ViewModel.ShowProfilePlot" ElementName="Root"/>
                    <Binding Path="ViewModel.PlotVm.HasMultipleReaches" ElementName="Root"/>
                </MultiBinding>
            </GridSplitter.Visibility>
        </GridSplitter>

        <!-- Reach selector — only visible on the Main tab when the profile model has
             multiple reaches. -->
        <Border Grid.Column="4"
                MinWidth="110"
                Background="{StaticResource BackgroundBrushSidePanels}">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                    <Binding Path="ViewModel.ShowProfilePlot" ElementName="Root"/>
                    <Binding Path="ViewModel.PlotVm.HasMultipleReaches" ElementName="Root"/>
                </MultiBinding>
            </Border.Visibility>
            <StackPanel Margin="6,6,6,0">
                <TextBlock Text="REACHES"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrushDark}"
                           Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding ViewModel.PlotVm.Reaches, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Command="{Binding ElementName=Root, Path=ViewModel.PlotVm.ReachSelectionChangedCommand}"
                                      FontSize="9"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      Margin="0,2,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
