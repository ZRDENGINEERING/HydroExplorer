<UserControl x:Class="HydroExplorer.View.TabBotItem.TabBotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:HydroExplorer.ViewModel.TabBotItem" 
             xmlns:views="clr-namespace:HydroExplorer.View.TabBotItem" 
             xmlns:behaviors="clr-namespace:HydroExplorer.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    

    <UserControl.DataContext>
        <vm:TabBotControlViewModel/>
    </UserControl.DataContext>


    <TabControl TabStripPlacement="Bottom">
        <TabItem Header="Chart">
            <views:TabBotChartsView/>
        </TabItem>
        <TabItem Header="Output">
            <views:TabBotOutputView/>
        </TabItem>
    </TabControl>





</UserControl>