<UserControl x:Class="HydroExplorer.View.HydraulicsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:views="clr-namespace:HydroExplorer.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="250">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="300" MinHeight="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <GroupBox Grid.Row="0"
                  Header="HYDRAULICS"
                  FontSize="12" FontWeight="Bold"
                  Background="{StaticResource BackgroundBrushHeader}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8"/>

        <!-- Filtered Tree: .prj files only -->
        <views:FilteredTreeView Grid.Row="1" FileExtensionFilter=".prj"/>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2" Width="400"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}"
                      ShowsPreview="False"/>

        <!-- Active Paths -->
        <GroupBox Grid.Row="3"
                  Header="ACTIVE PATHS"
                  FontSize="12" FontWeight="Bold"
                  Foreground="{StaticResource ForegroundBrush}"
                  Background="{StaticResource BackgroundBrushLight}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8">
            <StackPanel Background="{StaticResource BackgroundBrushSidePanels}">


                <TextBlock Text="{Binding ProfileMismatchWarning}"
                    Foreground="Red" FontSize="10" FontWeight="Bold"
                    TextWrapping="Wrap" Margin="10,4,10,4"/>


                <TextBlock FontSize="10" Margin="10,4,0,6">
                    <Run Text="Plan Name A: " Foreground="{StaticResource ForegroundBrush}"/>
                    <Run Text="{Binding ElementName=txtBoxHdfPathA, Path=Text}" Foreground="{StaticResource ForegroundBrushDark}"/>
                </TextBlock>

                <TextBox Name="txtBoxHdfPathA" Visibility="Collapsed"/>

                <ComboBox Name="cboxPlanNameA"
                    FontSize="10" Background="#543d05" BorderThickness="0"
                    Width="200" Margin="0,0,0,10"
                    Foreground="{StaticResource ForegroundBrushDark}"/>



                <TextBlock FontSize="10" Margin="10,4,0,6">
                    <Run Text="Plan Name B: " Foreground="{StaticResource ForegroundBrush}"/>
                    <Run Text="{Binding ElementName=txtBoxHdfPathB, Path=Text}" Foreground="{StaticResource ForegroundBrushDark}"/>
                </TextBlock>

                <TextBox Name="txtBoxHdfPathB" Visibility="Collapsed"/>

                <ComboBox Name="cboxPlanNameB"
                    FontSize="10" Background="#543d05" BorderThickness="0"
                    Width="200" Margin="0,0,0,10"
                    Foreground="{StaticResource ForegroundBrushDark}"/>

                
                
                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Profile:</TextBlock>
                <ComboBox Name="cboxProfiles"
                          
                          FontSize="10" Background="#543d05" BorderThickness="0"
                          Width="200" Margin="0,0,0,6"
                          Foreground="{StaticResource ForegroundBrushDark}"/>

                <TextBlock x:Name="txtProfileWarning"
                    Foreground="Red" FontSize="10" FontWeight="Bold"
                    TextWrapping="Wrap" Margin="10,4,10,4"
                    Text=""/>
                
                
                
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
