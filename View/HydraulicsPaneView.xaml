<UserControl x:Class="HydroExplorer.View.HydraulicsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:views="clr-namespace:HydroExplorer.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="150">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="330" MinHeight="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <GroupBox Grid.Row="0"
                  Header="HYDRAULICS"
                  FontSize="12" FontWeight="SemiBold"
                  Background="{StaticResource BackgroundBrushHeader}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8"/>

        <!-- Filtered Tree: .prj files only -->
        <views:FilteredTreeView Grid.Row="1"
                                FileExtensionFilter=".prj"/>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2" Width="400"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}"
                      ShowsPreview="False"/>

        <!-- Active Paths -->
        <GroupBox Grid.Row="3"
                  Header="ACTIVE PATHS"
                  FontSize="12" FontWeight="SemiBold"
                  Foreground="{StaticResource ForegroundBrush}"
                  Background="{StaticResource BackgroundBrushLight}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8">
            <StackPanel Background="{StaticResource BackgroundBrushSidePanels}">

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Proj Path:</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Click="BrowseProjPath_Click"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox Name="txtBoxProjPath"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Plan Name A:</TextBlock>
                <ComboBox Name="cboxPlanNameA"
                          
                          FontSize="10" Background="#543d05" BorderThickness="0"
                          Width="200" Margin="0,0,0,2"
                          Foreground="{StaticResource ForegroundBrushDark}"/>
                <TextBox Name="txtBoxHdfPathA"
                         FontSize="8" IsReadOnly="True" BorderThickness="0"
                         Width="220" HorizontalAlignment="Left" Margin="15,0,0,6"
                         Foreground="{StaticResource ForegroundBrushDark}"/>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Plan Name B:</TextBlock>
                <ComboBox Name="cboxPlanNameB"
                          
                          FontSize="10" Background="#543d05" BorderThickness="0"
                          Width="200" Margin="0,0,0,2"
                          Foreground="{StaticResource ForegroundBrushDark}"/>
                <TextBox Name="txtBoxHdfPathB"
                         FontSize="8" IsReadOnly="True" BorderThickness="0"
                         Width="220" HorizontalAlignment="Left" Margin="15,0,0,6"
                         Foreground="{StaticResource ForegroundBrushDark}"/>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Profile:</TextBlock>
                <ComboBox Name="cboxProfiles"
                          
                          FontSize="10" Background="#543d05" BorderThickness="0"
                          Width="200" Margin="0,0,0,6"
                          Foreground="{StaticResource ForegroundBrushDark}"/>

            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
