<UserControl x:Class="HydroExplorer.View.UserControls.ViewButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:vm="clr-namespace:HydroExplorer.ViewModel" 
             d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="150">



        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>



                <RadioButton Content="PROJECTS"
                                 Grid.Row="1"
                                 FontSize="12"
                                 IsChecked="True"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 Command="{Binding HomeViewCommand}"/>

                <RadioButton Content="DATA GRID"
                                 Grid.Row="2"
                                 Width="90"
                                 FontSize="12"
                                 Foreground="{StaticResource ForegroundBrush}"
                                Command="{Binding DataGridViewCommand}"/>

                <RadioButton Content="MAPPING"
                                 Grid.Row="3"
                                 Width="90"
                                 FontSize="12"
                                 Foreground="{StaticResource ForegroundBrush}"
                                 Command="{Binding MapViewCommand}"/>


                <StackPanel Orientation="Vertical"
                                    Grid.Row="4"
                                    Margin="10,15,0,10">

                    <TextBlock Text="Rivers"
                                Foreground="{StaticResource ForegroundBrush}"
                                FontSize="10"
                                />

                    <TextBlock Text="Reaches"
                                HorizontalAlignment="Left"
                                Foreground="{StaticResource ForegroundBrush}"
                                FontSize="10"
                                />

                    <TextBlock Text="Profiles"
                                Foreground="{StaticResource ForegroundBrush}"
                                FontSize="10"
                                />

                    <TextBlock Text="Plans"
                                Foreground="{StaticResource ForegroundBrush}"
                                FontSize="10"
                                />
                </StackPanel>

    </Grid>

</UserControl>
