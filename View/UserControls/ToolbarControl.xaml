<UserControl x:Class="HydroExplorer.View.UserControls.ToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrushDark}">

    <UserControl.Resources>
        <!-- Reusable icon button style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DDE8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Divider style -->
        <Style x:Key="DividerStyle" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="#AAAAAA"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">

        <!-- Group 1 -->
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 1"
                Command="{Binding Action1Command}">
            <Image Source="/Assets/Icons/icon1.png" Width="20" Height="20"/>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 2"
                Command="{Binding Action2Command}">
            <Image Source="/Assets/Icons/icon2.png" Width="20" Height="20"/>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 3"
                Command="{Binding Action3Command}">
            <Image Source="/Assets/Icons/icon3.png" Width="20" Height="20"/>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 4"
                Command="{Binding Action4Command}">
            <Image Source="/Assets/Icons/icon4.png" Width="20" Height="20"/>
        </Button>

        <!-- Divider -->
        <Separator Style="{StaticResource DividerStyle}"/>

        <!-- Group 2 -->
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 5"
                Command="{Binding Action5Command}">
            <Image Source="/Assets/Icons/icon5.png" Width="20" Height="20"/>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 6"
                Command="{Binding Action6Command}">
            <Image Source="/Assets/Icons/icon6.png" Width="20" Height="20"/>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 7"
                Command="{Binding Action7Command}">
            <Image Source="/Assets/Icons/icon7.png" Width="20" Height="20"/>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Action 8"
                Command="{Binding Action8Command}">
            <Image Source="/Assets/Icons/icon8.png" Width="20" Height="20"/>
        </Button>

    </StackPanel>
</UserControl>