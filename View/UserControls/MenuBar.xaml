<UserControl x:Class="HydroExplorer.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer"
             mc:Ignorable="d" 
             d:DesignWidth="800">



    <!-- Menu Bar -->
    <Grid Background="{StaticResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <Menu Background="{StaticResource BackgroundBrush}" Foreground="LightGray">
            <MenuItem Header="File"
                      VerticalAlignment="Center"
                      FontSize="12">
                <MenuItem Header="Exit" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>
            <MenuItem Header="Edit" 
                      VerticalAlignment="Center"
                      FontSize="12">
                <MenuItem Header="Edit This" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>

            <MenuItem Header="View"
                      VerticalAlignment="Center"
                      FontSize="12">
                <MenuItem Header="Exit" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>

            <MenuItem Header="Project"
                      VerticalAlignment="Center"
                      FontSize="12">
                <MenuItem Header="Exit" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>

            <MenuItem Header="Tools"
                      VerticalAlignment="Center"
                      FontSize="12">
                <MenuItem Header="Exit" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>
        </Menu>
        </Grid>
</UserControl>
