<UserControl x:Class="HydroExplorer.View.UserControls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer"
             mc:Ignorable="d" 
             d:DesignWidth="800">



    <!-- Menu Bar -->
    <Grid Background="{StaticResource BackgroundBrushSidePanels}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
        <Menu Background="{StaticResource BackgroundBrush}" Foreground="LightGray">
            <MenuItem Header="File" VerticalAlignment="Center">

                <MenuItem Header="File Menu" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>
            
            <MenuItem Header="Edit" VerticalAlignment="Center">
                <MenuItem Header="Edit Menu" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>

            <MenuItem Header="View" VerticalAlignment="Center">
                <MenuItem Header="View Menu" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>

            <MenuItem Header="Project" VerticalAlignment="Center">
                <MenuItem Header="Project Menu" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>

            <MenuItem Header="Tools" VerticalAlignment="Center">
                <MenuItem Header="Tools Menu" Background="{StaticResource BackgroundBrush}"/>
            </MenuItem>
        </Menu>
        </Grid>
</UserControl>
