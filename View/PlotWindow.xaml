<Window x:Class="HydroExplorer.View.PlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:vm="clr-namespace:HydroExplorer.ViewModel"
        Title="Plot" Height="500" Width="700">


    <Window.DataContext>
        <vm:PlotViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Plot -->
        <oxy:PlotView Grid.Row="0" Model="{Binding PlotModel}" />

        <!-- Optional close button -->
        <Button Grid.Row="1" Content="Close" Width="80"
                HorizontalAlignment="Right" Margin="0,0,10,5"
                Click="CloseButton_Click"/>
    </Grid>
</Window>