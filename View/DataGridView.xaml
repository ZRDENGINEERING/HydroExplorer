<UserControl x:Class="HydroExplorer.View.DataGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer.View"
             xmlns:hlp="clr-namespace:HydroExplorer.Helpers"
             xmlns:utils="clr-namespace:HydroExplorer.Utils" 
             d:DataContext="{d:DesignInstance Type=local:HecRasProfileResult}"
             mc:Ignorable="d" 
             d:DesignHeight="1650" d:DesignWidth="800">

    <UserControl.Resources>
            <hlp:ValueToColorConverter x:Key="ValueToColorConverter"/>
            <Style x:Key="ColAStyle" TargetType="DataGridCell">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="border" Background="#2e2e2e" BorderThickness="0" SnapsToDevicePixels="True">
                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource DataGrid.CellItem.MouseOver.Background}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource DataGrid.Row.Selected.Background}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        <Style x:Key="DeltaStyle" TargetType="DataGridCell">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="border" Background="#232f3b" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                        Value="{DynamicResource DataGrid.CellItem.MouseOver.Background}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background"
                        Value="{DynamicResource DataGrid.Row.Selected.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#181818" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <TextBlock Text="HEC-RAS PROFILE COMPARISON"
            FontSize="14" FontWeight="Bold"
                   Foreground="#925353"
            VerticalAlignment="Center"
            Margin="10,0,0,0"/>

        <DataGrid x:Name="dgSimple"
          Grid.Row="1"
          Grid.RowSpan="2"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          SelectionChanged="DgSimpleSlctChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reach"       Binding="{Binding Reach}"          
                                    Width="80"  Foreground="Gray" ElementStyle="{StaticResource CenterStyle}"/>
                <DataGridTextColumn Header="River Sta"   Binding="{Binding RiverSta}"        
                                    Width="60"  ElementStyle="{StaticResource CenterStyle}"/>
                <DataGridTextColumn Header="Profile"     Binding="{Binding Profile}"         
                                    Width="60"  Foreground="Gray" ElementStyle="{StaticResource CenterStyle}"/>

                <DataGridTextColumn Header="QTotal A"    Binding="{Binding QTotalADisplay}"  
                                    Width="65"  Foreground="Gray" ElementStyle="{StaticResource CenterStyle}"/>
                <DataGridTextColumn Header="WSElev A" Binding="{Binding WSElevA}" Width="68"
                    ElementStyle="{StaticResource CenterStyle}"
                    CellStyle="{StaticResource ColAStyle}"/>
           
                <DataGridTextColumn Header="QTotal B"    Binding="{Binding QTotalBDisplay}"  Width="65"  Foreground="Gray" ElementStyle="{StaticResource CenterStyle}"/>
                <DataGridTextColumn Header="WSElev B"    Binding="{Binding WSElevBDisplay}"  Width="68"  ElementStyle="{StaticResource CenterStyle}"/>

                <DataGridTextColumn Header="DELTA" Binding="{Binding DELTADisplay}" Width="65" CellStyle="{StaticResource DeltaStyle}">
                    
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="Foreground"
                            Value="{Binding DELTA, Converter={StaticResource ValueToColorConverter}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>