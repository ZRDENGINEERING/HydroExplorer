<UserControl x:Class="HydroExplorer.View.GeometryPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:views="clr-namespace:HydroExplorer.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="150">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="300" MinHeight="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <GroupBox Grid.Row="0"
                  Header="GEOMETRY"
                  FontSize="12" FontWeight="Bold"
                  Background="{StaticResource BackgroundBrushHeader}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8"/>

        <!-- Filtered Tree: .shp files only -->
        <views:FilteredTreeView Grid.Row="1" FileExtensionFilter=".shp"/>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2" Width="400"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}"
                      ShowsPreview="False"/>

        <!-- Active Paths -->
        <GroupBox Grid.Row="3"
          Header="ACTIVE PATHS"
          FontSize="12" FontWeight="Bold"
          Foreground="{StaticResource ForegroundBrush}"
          Background="{StaticResource BackgroundBrushLight}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="0.8">
            <StackPanel Background="{StaticResource BackgroundBrushSidePanels}">

                <TextBlock FontSize="10" Margin="10,4,0,0"
                   Foreground="{StaticResource ForegroundBrush}">Sub-Basin Boundary (.shp):</TextBlock>
                <Grid Margin="15,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                       Text="{Binding SelectedBoundaryPath.ShpPath, Mode=OneWay}"
                       FontSize="8" TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrushDark}"/>
                    <Button Grid.Column="1" Content="..."
                    Command="{Binding BrowseShpCommand}"
                    CommandParameter="Boundary"
                    Width="22" Height="20" Padding="0" FontSize="10"
                    VerticalAlignment="Top"
                    Background="{StaticResource BackgroundBrushSidePanels}"/>
                </Grid>

                
                <TextBlock FontSize="10" Margin="10,4,0,0"
                   Foreground="{StaticResource ForegroundBrush}">River (.shp):</TextBlock>
                <Grid Margin="15,0,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                       Text="{Binding SelectedRiverPath.ShpPath, Mode=OneWay}"
                       FontSize="8" TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrushDark}"/>
                    <Button Grid.Column="1" Content="..."
                    Command="{Binding BrowseShpCommand}"
                    CommandParameter="River"
                    Width="22" Height="20" Padding="0" FontSize="10"
                    VerticalAlignment="Top"
                    Background="{StaticResource BackgroundBrushSidePanels}"/>
                </Grid>


                <TextBlock FontSize="10" Margin="10,4,0,0"
                   Foreground="{StaticResource ForegroundBrush}">Cross Sections (.shp):</TextBlock>
                                <Grid Margin="15,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSectionsPath.ShpPath, Mode=OneWay}"
                       FontSize="8" TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrushDark}"/>
                                    <Button Grid.Column="1" Content="..."
                    Command="{Binding BrowseShpCommand}"
                    CommandParameter="Sections"
                    Width="22" Height="20" Padding="0" FontSize="10"
                    VerticalAlignment="Top"
                    Background="{StaticResource BackgroundBrushSidePanels}"/>
                </Grid>




            </StackPanel>
        </GroupBox>
        
        
    </Grid>
</UserControl>
