<UserControl x:Class="HydroExplorer.View.GeometryPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:views="clr-namespace:HydroExplorer.View"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="150">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="330" MinHeight="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <GroupBox Grid.Row="0"
                  Header="GEOMETRY"
                  FontSize="12" FontWeight="SemiBold"
                  Background="{StaticResource BackgroundBrushHeader}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8"/>

        <!-- Filtered Tree: .shp files only -->
        <views:FilteredTreeView Grid.Row="1"
                                FileExtensionFilter=".shp"/>

        <!-- Splitter -->
        <GridSplitter Grid.Row="2" Width="400"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}"
                      ShowsPreview="False"/>

        <!-- Active Paths -->
        <GroupBox Grid.Row="3"
                  Header="ACTIVE PATHS"
                  FontSize="12" FontWeight="SemiBold"
                  Foreground="{StaticResource ForegroundBrush}"
                  Background="{StaticResource BackgroundBrushLight}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0.8">
            <StackPanel Background="{StaticResource BackgroundBrushSidePanels}">

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Boundary (.shp):</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Command="{Binding BrowseShpCommand}"
                            CommandParameter="Boundary"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox Text="{Binding SelectedBoundaryPath.Name, Mode=OneWay}"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Cross Sections (.shp):</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Command="{Binding BrowseShpCommand}"
                            CommandParameter="Sections"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox Text="{Binding SelectedSectionsPath.Name, Mode=OneWay}"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">Subbasins (.shp):</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Command="{Binding BrowseShpCommand}"
                            CommandParameter="Subbasins"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox Text="{Binding SelectedSubbasinsPath.Name, Mode=OneWay}"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

                <TextBlock FontSize="10" Margin="10,4,0,0"
                           Foreground="{StaticResource ForegroundBrush}">RAS Geometry (.hdf):</TextBlock>
                <DockPanel Margin="15,0,4,4">
                    <Button DockPanel.Dock="Right" Content="..."
                            Command="{Binding BrowseShpCommand}"
                            CommandParameter="RasGeometry"
                            Width="22" Height="20" Padding="0" FontSize="10"
                            Background="{StaticResource BackgroundBrushSidePanels}"/>
                    <TextBox Text="{Binding SelectedRasGeometryPath.Name, Mode=OneWay}"
                             FontSize="8" IsReadOnly="True" BorderThickness="0"
                             Foreground="{StaticResource ForegroundBrushDark}"/>
                </DockPanel>

            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
