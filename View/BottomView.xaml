<UserControl x:Class="HydroExplorer.View.BottomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HydroExplorer"
             xmlns:view="clr-namespace:HydroExplorer.View.TabBotItem" 
             xmlns:vm="clr-namespace:HydroExplorer.ViewModel" 
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             d:DesignHeight="200" d:DesignWidth="600">

    <Grid>



        <!-- Top Pane -->
        <view:TabBotControlView Grid.Row="0" Grid.RowSpan="1" 
                                Grid.Column="0" Grid.ColumnSpan="1"
                                Background="{StaticResource BackgroundBrushDark}" 
                                Foreground="blue"/>



    </Grid>

</UserControl>
