<UserControl x:Class="HydroExplorer.View.TabItem.TabMainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HydroExplorer.View.TabItem"
      xmlns:view="clr-namespace:HydroExplorer.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">


    <Grid Background="{StaticResource BackgroundBrushDark}">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Map Pane -->
        <view:MapView Grid.Column="0" Grid.Row="0" Height="Auto" Width="Auto" Margin="2,2,0,2"/>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Grid.Row="0" Width="4" 
              ResizeBehavior="PreviousAndNext"
              Background="{StaticResource DividerBrush}"
              ShowsPreview="False"/>

        <!-- Table Pane -->
        <view:DataGridView Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Height="Auto" Width="Auto"/>


    </Grid>
</UserControl>