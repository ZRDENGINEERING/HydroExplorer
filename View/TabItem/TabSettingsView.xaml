<UserControl x:Class="HydroExplorer.View.TabItem.TabSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HydroExplorer.View.TabItem"
      xmlns:vm="clr-namespace:HydroExplorer.ViewModel.TabItem" 
      d:DataContext="{d:DesignInstance Type=vm:TabSettingsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">


    <Grid Background="{StaticResource BackgroundBrushDark}">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Label Name="txtBoxProjPathLbl" Grid.Column="0" Grid.Row="2" Foreground="LightGray"
              VerticalAlignment="Center" FontSize="10">Project Path:</Label>

        <TextBox Name="txtBoxProjPath" Grid.Column="1" Grid.Row="2" MinWidth="250" Background="DarkGoldenrod"
                 VerticalAlignment="Center" FontSize="10"
                 Text="{Binding ProjPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                 ></TextBox>




        <Label Name="projNameLbl" Grid.Column="0" Grid.Row="3" Foreground="LightGray" 
               VerticalAlignment="Center" FontSize="10">Project Name:</Label>

        <TextBox Name="projName" Grid.Column="1" Grid.Row="3" MinWidth="250" Background="DarkGoldenrod"
                 VerticalAlignment="Center" FontSize="10"
                 Text="{Binding ProjName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                 ></TextBox>


        <Label Name="txtBoxPlanNameLblA" Grid.Column="0" Grid.Row="4" Foreground="LightGray" 
               VerticalAlignment="Center" FontSize="10">Plan Name:</Label>

        <TextBox Name="txtBoxPlanNameA" Grid.Column="1" Grid.Row="4" MinWidth="250" Background="DarkGoldenrod"
                     VerticalAlignment="Center" FontSize="10"
                 Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                 ></TextBox>

        

        <Label Name="txtBoxProNameLbl" Grid.Column="0" Grid.Row="5" Foreground="LightGray" 
               VerticalAlignment="Center" FontSize="10">Pro Name:</Label>

        <TextBox Name="txtBoxProName" Grid.Column="1" Grid.Row="5" MinWidth="250" Background="DarkGoldenrod"
                 VerticalAlignment="Center" FontSize="10"
                 Text="{Binding ProName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                 ></TextBox>


        <Label Name="txtBoxPlanNameLblB" Grid.Column="0" Grid.Row="4" Foreground="LightGray" 
       VerticalAlignment="Center" FontSize="10">Plan Name:</Label>

        <TextBox Name="txtBoxPlanNameB" Grid.Column="1" Grid.Row="4" MinWidth="250" Background="DarkGoldenrod"
                 VerticalAlignment="Center" FontSize="10"
                Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                ></TextBox>
        
        

        <Button Name="appConfigSave" Grid.Column="5" Grid.Row="6" 
                Width="100" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                FontWeight="Bold"                
                Click="Button_Click"
                >SAVE SETTINGS</Button>



        <TextBlock Text="Model Monitor"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"
                   Foreground="LightGray"
                   FontSize="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10,0,0,20"/>

        <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Height="30">

                <TextBlock Text="From UMP Endpoint / Device"
                           Foreground="LightGray"
                           Width="150"
                           FontSize="10"
                           Margin="100,0,0,0"/>

                <TextBlock Text="Timestamp"
                           Foreground="LightGray"
                           Width="150"
                           FontSize="10"
                           Margin="200,0,0,0"/>
            </StackPanel>
        </StackPanel>



        <StackPanel Margin="10" Grid.Row="1" Grid.RowSpan="4" Grid.Column="3" Grid.ColumnSpan="2">
            <Label FontSize="10" FontWeight="Bold" Foreground="LightGray">PLAN COMPARISON OPTIONS</Label>
            <StackPanel>
                <StackPanel Margin="20,0">
                    <CheckBox Name="cbFeatureAbc" Checked="CbFeature_CheckedChanged" FontSize="10"
                              Unchecked="CbFeature_CheckedChanged" Foreground="LightGray">Enable feature ABC</CheckBox>

                    <CheckBox Name="cbFeatureXyz" IsChecked="True" Checked="CbFeature_CheckedChanged" FontSize="10"
                              Unchecked="CbFeature_CheckedChanged" Foreground="LightGray">Enable feature XYZ</CheckBox>

                    <CheckBox Name="cbFeatureWww" Checked="CbFeature_CheckedChanged" FontSize="10"
                              Unchecked="CbFeature_CheckedChanged" Foreground="LightGray">Enable feature WWW</CheckBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>









    </Grid>
</UserControl>
