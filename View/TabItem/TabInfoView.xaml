<UserControl x:Class="HydroExplorer.View.TabItem.TabInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:view="clr-namespace:HydroExplorer.View"
      xmlns:vm="clr-namespace:HydroExplorer.ViewModel.TabItem" 
      d:DataContext="{d:DesignInstance Type=vm:TabInfoViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    
    <Grid Background="{StaticResource BackgroundBrushSidePanels}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="260"/>
            
        </Grid.ColumnDefinitions>


        <!-- Site Info Text -->
        <TextBlock Text="PROJECT DATA"
                   Grid.ColumnSpan="2"
                   Grid.Row="0"
                   Foreground="LightCoral"
                   FontWeight="Bold"
                   TextDecorations="Underline"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,20,0,10"/>

        <StackPanel Orientation="Vertical"
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="20,45,0,0"
            VerticalAlignment="Top">

            <TextBlock FontSize="11">
                <Run Text="Project Name: " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding ProjName}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>        
            </TextBlock>


            <TextBlock Text="Model Info:" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="HEC-RAS Model: " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding RasModel}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="HEC-HMS Model: " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding HmsModel}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>        
            </TextBlock>

            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="SubBasin Area (sq.mi.): " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding DrainageAreaSqMi}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="SubBasin Area (acres): " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding DrainageAreaAcre}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>


            <TextBlock Text="USGS Info:" FontSize="12" Margin="0,10,0,0"/>
            
            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="Station Name: " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding UsgsStationName}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>

            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="Site Number: " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding UsgsNumber}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>

            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="HUC Code: " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding HucCode}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="Drainage Area (sq.mi.): " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding UsgsDrainageAreaSqMi}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock FontSize="10" Margin="10,0,0,0">
                <Run Text="Drainage Area (acres): " Foreground="{StaticResource ForegroundBrushDark}"/>
                <Run Text="{Binding UsgsDrainageAreaAcre}" Foreground="{StaticResource ForegroundBrush}" FontWeight="Bold"/>
            </TextBlock>


        </StackPanel>

        
        
        <!-- Map Pane -->
        <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="3" Grid.ColumnSpan="2" Height="280" Width="400"
        Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">
            <ContentControl x:Name="MapContainer"/>
        </Border>


    </Grid>
</UserControl>