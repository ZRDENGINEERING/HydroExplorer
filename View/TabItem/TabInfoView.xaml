<UserControl x:Class="HydroExplorer.View.TabItem.TabInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:view="clr-namespace:HydroExplorer.View"
      xmlns:vm="clr-namespace:HydroExplorer.ViewModel.TabItem" 
      d:DataContext="{d:DesignInstance Type=vm:TabInfoViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{StaticResource BackgroundBrushDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Site Info Text -->
        <TextBlock Text="Site Information"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"
                   Foreground="{StaticResource ForegroundBrush}"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10,0,0,20"/>

        <StackPanel Orientation="Vertical"
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Top">
            <TextBlock Name="txtBlockProjectName" Text="Project Name: " FontSize="11"/>
            <TextBlock Name="txtBlockAreaSqMi" Text="Drainage Area (sq.mi.): " FontSize="10"/>
            <TextBlock Name="txtBlockAreaAcre" Text="Drainage Area (acre): " FontSize="10"/>
            <TextBlock Name="txtBlockUSGSInfo" Text="USGS Info: " FontSize="12" Margin="0,10,0,0"/>
            <TextBlock Name="txtBlockSiteNumber" Text="Site Number: " FontSize="10" Margin="10,0,0,0"/>
            <TextBlock Name="txtBlockStationName" Text="Station Name: " FontSize="10" Margin="10,0,0,0"/>
            <TextBlock Name="txtBlockHUC" Text="HUC Code: " FontSize="10" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Map Pane -->
        <ContentControl x:Name="MapContainer" Grid.Row="1" Grid.RowSpan="5" Margin="20,0,0,0" Grid.Column="1"/>

        <!-- Recent Projects -->
        <GroupBox Header="Recent Projects" 
                  Grid.Row="1" Grid.RowSpan="4"
                  Grid.Column="2" Grid.ColumnSpan="2"
                  Margin="100,0,10,0"
                  Background="{StaticResource BackgroundBrushDark}"
                  BorderBrush="{StaticResource Button.Disabled.Border}"
                  BorderThickness="0.8">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <DockPanel>
                <ListBox ItemsSource="{Binding RecentProjects}"
                         SelectedItem="{Binding SelectedRecentProject, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FilePath}"
                                           Foreground="{StaticResource ForegroundBrushDark}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}"/>
                                <TextBlock Text="{Binding LastOpened, StringFormat='Last opened: {0:MM/dd/yyyy h:mm tt}'}"
                                           Foreground="Gray" FontSize="9"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <!-- Recent HMS Projects -->
        <GroupBox Header="Recent HMS Projects" 
                  Grid.Row="5" Grid.RowSpan="2"
                  Grid.Column="2" Grid.ColumnSpan="2"
                  Margin="100,0,10,0"
                  Background="{StaticResource BackgroundBrushDark}"
                  BorderBrush="{StaticResource Button.Disabled.Border}"
                  BorderThickness="0.8">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <DockPanel>
                <Button DockPanel.Dock="Bottom"
                        Content="CLEAR ALL RECENT PROJECTS"
                        Command="{Binding ClearAllRecentCommand}"
                        Margin="0,4,0,0"
                        Padding="6,3"
                        HorizontalAlignment="Left"
                        Background="{StaticResource BackgroundBrush}"
                        FontSize="8"/>

                <ListBox ItemsSource="{Binding RecentHmsProjects}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FilePath}"
                                           Foreground="{StaticResource ForegroundBrushDark}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FilePath}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>