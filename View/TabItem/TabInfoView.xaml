<UserControl x:Class="HydroExplorer.View.TabItem.TabInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:view="clr-namespace:HydroExplorer.View"
      xmlns:vm="clr-namespace:HydroExplorer.ViewModel.TabItem" 
      d:DataContext="{d:DesignInstance Type=vm:TabInfoViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">

    
    <Grid Background="{StaticResource BackgroundBrushSidePanels}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        <!-- Site Info Text -->
        <TextBlock Text="Site Information"
                   Grid.ColumnSpan="2"
                   Grid.Row="1"
                   Foreground="{StaticResource ForegroundBrush}"
                   FontSize="16"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10,0,0,20"/>

        <StackPanel Orientation="Vertical"
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Top">
            
            <TextBlock Name="txtBlockProjectName" Text="Project Name: " FontSize="11"/>
            <TextBlock Name="txtBlockAreaSqMi" Text="Drainage Area (sq.mi.): " FontSize="10"/>
            <TextBlock Name="txtBlockAreaAcre" Text="Drainage Area (acre): " FontSize="10"/>
            <TextBlock Name="txtBlockUSGSInfo" Text="USGS Info: " FontSize="12" Margin="0,10,0,0"/>
            <TextBlock Name="txtBlockSiteNumber" Text="Site Number: " FontSize="10" Margin="10,0,0,0"/>
            <TextBlock Name="txtBlockStationName" Text="Station Name: " FontSize="10" Margin="10,0,0,0"/>
            <TextBlock Name="txtBlockHUC" Text="HUC Code: " FontSize="10" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Map Pane -->
        <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="3" Grid.ColumnSpan="2"
        Margin="5"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">
            <ContentControl x:Name="MapContainer"/>
        </Border>


    </Grid>
</UserControl>