<UserControl x:Class="HydroExplorer.View.TabItem.TabChartView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:oxy="http://oxyplot.org/wpf"
      xmlns:vm="clr-namespace:HydroExplorer.ViewModel.TabItem"
      d:DataContext="{d:DesignInstance Type=vm:TabChartViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">



    <Grid Background="{StaticResource BackgroundBrushMed}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: elevation on top, hydrograph on bottom -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Elevation plot (top) -->
            <oxy:PlotView Grid.Row="0" Model="{Binding ElevationPlot}"
                  Visibility="{Binding ElevationPlotVisibility}"
                  Background="{StaticResource BackgroundBrushMed}"
                  BorderThickness="0"/>

            <TextBlock Text="No elevation data available"
                Foreground="Gray" FontSize="12" FontStyle="Italic"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ElevationWatermarkVisibility}"/>



            <GridSplitter Grid.Row="1"
                  Height="4"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"/>

            <!-- Hydrograph plot (bottom) -->
            <oxy:PlotView Grid.Row="2"
                  Model="{Binding HydrographPlot}"
                  Background="{StaticResource BackgroundBrushMed}"
                  BorderThickness="0"/>
            
            
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BackgroundBrushSidePanels}"/>

        
        
        <!-- Right: hyetograph + info panel -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <!-- Hyetograph stats -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,0"
                    Padding="10,8">
                <StackPanel>
                    <TextBlock Text="HYETOGRAPH (INCHES)"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="10" FontWeight="Bold"
                               TextDecorations="Underline"
                               Margin="10,0,0,6"/>



                    <Grid>
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="RAINFALL TOTAL   ..................................................." 
                           Foreground="{StaticResource ForegroundBrushDark}" FontSize="9" Margin="15,0,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="LOSS TOTAL   ............................................................" 
                           Foreground="{StaticResource ForegroundBrushDark}" FontSize="9" Margin="15,0,0,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RAINFALL - EXCESS TOTAL   ..............................." 
                           Foreground="{StaticResource ForegroundBrushDark}" FontSize="9" Margin="15,0,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="INITIAL LOSS   .........................................................." 
                           Foreground="{StaticResource ForegroundBrushDark}" FontSize="9" Margin="15,0,0,0"/>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding RainfallTotal, StringFormat={}{0:F2}}"
                           Foreground="{StaticResource ForegroundBrush}" FontSize="9"  Margin="0,0,90,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding LossTotal, StringFormat={}{0:F2}}"
                           Foreground="{StaticResource ForegroundBrush}" FontSize="9"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding RainfallExcessTotal, StringFormat={}{0:F2}}"
                           Foreground="{StaticResource ForegroundBrush}" FontSize="9"/>
                                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding InitialLoss, StringFormat={}{0:F2}}"
                           Foreground="{StaticResource ForegroundBrush}" FontSize="9"/> 
                    </Grid>
                    
                    
                    
                </StackPanel>
            </Border>

            <!-- Hyetograph bar chart -->
            <oxy:PlotView Grid.Row="1"
                          Model="{Binding HyetographPlot}"
                          Background="{StaticResource BackgroundBrushMed}"
                          BorderThickness="0"
                          Margin="6,4,6,4"/>

            <!-- Title block -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="6,0,6,6"
                    Padding="10,8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="XX RIVER BASIN"
                               Foreground="{StaticResource ForegroundBrushDark}"
                               FontSize="8" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="PROJECT XX"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="BEXAR COUNTY, TEXAS"
                               Foreground="{StaticResource ForegroundBrushDark}"
                               FontSize="8" HorizontalAlignment="Center"
                               Margin="0,4,0,4"/>
                    
                    <TextBlock Text="OUTFALL HYDROGRAPH"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>


        </Grid>
    </Grid>
</UserControl>