<UserControl x:Class="HydroExplorer.View.DataGridViewHMS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HydroExplorer.View"
        mc:Ignorable="d"
        Height="450" Width="800">


        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter bar -->
            <ToolBar Grid.Row="0" Margin="2">
                <Label Content="Filter:"/>
                <TextBox x:Name="FilterBox" Width="200"
                     TextChanged="FilterBox_TextChanged"
                     ToolTip="Filter any Part A–F column"/>
                <Separator/>
                <ComboBox x:Name="PartCCombo" Width="120"
                      SelectionChanged="PartCCombo_SelectionChanged"
                      ToolTip="Parameter (FLOW, PRECIP…)"/>
                <Separator/>
                <Button Content="Export CSV"  Click="ExportCsv_Click"/>
                <Button Content="Copy"        Click="CopyClipboard_Click"/>
                <Button Content="Clear Filter" Click="ClearFilter_Click"/>
            </ToolBar>

            <!-- DataGrid -->
            <DataGrid x:Name="DssGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  AlternatingRowBackground="#F5F7FA"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Part A (Basin)"     Binding="{Binding PartA}" Width="120"/>
                    <DataGridTextColumn Header="Part B (Location)"  Binding="{Binding PartB}" Width="140"/>
                    <DataGridTextColumn Header="Part C (Parameter)" Binding="{Binding PartC}" Width="100"/>
                    <DataGridTextColumn Header="Part D (Date)"      Binding="{Binding PartD}" Width="110"/>
                    <DataGridTextColumn Header="Part E (Interval)"  Binding="{Binding PartE}" Width="90"/>
                    <DataGridTextColumn Header="Part F (Version)"   Binding="{Binding PartF}" Width="100"/>
                    <DataGridTextColumn Header="Units"              Binding="{Binding Units}" Width="70"/>
                    <DataGridTextColumn Header="Type"               Binding="{Binding Type}"  Width="70"/>
                    <DataGridTextColumn Header="# Values"           Binding="{Binding Count}" Width="75"/>
                    <DataGridTextColumn Header="Pathname"           Binding="{Binding Pathname}" Width="*"/>
                </DataGrid.Columns>

                <!-- Row double-click → load values -->
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                              Command="{Binding LoadValuesCommand}"
                              CommandParameter="{Binding SelectedItem, ElementName=DssGrid}"/>
                </DataGrid.InputBindings>
            </DataGrid>

            <!-- Status bar -->
            <StatusBar Grid.Row="2">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Ready"/>
                </StatusBarItem>
                <Separator/>
                <StatusBarItem>
                    <TextBlock x:Name="RowCountText"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </UserControl>





