<Window x:Class="HydroExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HydroExplorer"
        xmlns:views="clr-namespace:HydroExplorer.View"
        xmlns:vm="clr-namespace:HydroExplorer.ViewModel"
        xmlns:userControls="clr-namespace:HydroExplorer.View.UserControls"
        mc:Ignorable="d" 
        Height="900" Width="1600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0.8" 
        Background="{StaticResource DividerBrush}"
        Top="30" Left="-2300">

    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="0.5"/>
            <RowDefinition Height="520"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*" MinHeight="50"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="20"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="100"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="250" MinWidth="20"/>
        </Grid.ColumnDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
              Height="25" Background="Black"
              VerticalAlignment="Top"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Image Source="/Images/logo_zrd.png" Height="20" Width="36"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Text="HydroExplorer"
                       Foreground="{StaticResource ForegroundBrush}"
                       VerticalAlignment="Center" FontSize="10" Margin="60,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="30" Height="30" FontSize="18" Margin="0,-1,0,0"
                        Background="Transparent" BorderThickness="0" Click="MinimizeButton_Click">
                    <TextBlock Text="─" Foreground="{StaticResource CloseButtonBrush}"/>
                </Button>
                <Button Width="30" Height="30" FontSize="18" Margin="0,-6,0,0"
                        Background="Transparent" BorderThickness="0" Click="MaximizeButton_Click">
                    <TextBlock Text="□" Foreground="{StaticResource CloseButtonBrush}"/>
                </Button>
                <Button Width="30" FontSize="12"
                        Background="Transparent" BorderThickness="0" Click="CloseButton_Click">
                    <TextBlock Text="✕" Foreground="{StaticResource CloseButtonBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Menu Bar -->
        <userControls:MenuBar Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1"
                              Margin="0,0,0,3" Foreground="{StaticResource ForegroundBrush}"/>

        <!-- Left Pane: Tabbed -->
        <TabControl x:Name="LeftTabControl"
            Grid.Column="0" Grid.Row="3" Grid.RowSpan="5"
            Margin="3,0,0,3"
            TabStripPlacement="Left"
            Style="{StaticResource NoOffsetTabControl}">

            <TabItem Header="HYDRAULICS" Style="{StaticResource NoOffsetTabItem}">
                <views:HydraulicsPaneView/>
            </TabItem>

            <TabItem Header="HYDROLOGY" Style="{StaticResource NoOffsetTabItem}">
                <views:HydrologyPaneView/>
            </TabItem>

            <TabItem Header="GEOMETRY" Style="{StaticResource NoOffsetTabItem}">
                <views:GeometryPaneView DataContext="{Binding TabInfoVM}"/>
            </TabItem>

        </TabControl>

        <!-- Left Splitter -->
        <GridSplitter Grid.Column="1" Grid.Row="3" Grid.RowSpan="3" Width="4"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource DividerBrush}" ShowsPreview="False"/>

        <!-- Center Pane -->
        <ContentControl Grid.Column="2" Grid.Row="2" Grid.RowSpan="3"
                        Content="{Binding CurrentView}"
                        Margin="0,0,0,0"
                        Background="{StaticResource BackgroundBrushDark}"/>

        <!-- Right Splitter -->
        <GridSplitter Grid.Column="3" Grid.Row="3" Grid.RowSpan="3" Width="4"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource DividerBrush}" ShowsPreview="False"/>

        <!-- Right Pane: Recent Projects -->
        <views:RecentProjectsView Grid.Column="4" Grid.Row="3" Grid.RowSpan="3"
                                  Margin="0,0,3,3"
                                  Background="{StaticResource BackgroundBrushDark}"
                                  DataContext="{Binding TabInfoVM}"/>

        <!-- Horizontal Splitter -->
        <GridSplitter Grid.Column="2" Grid.Row="4" Width="2000"
                      ResizeDirection="Rows"
                      Background="{StaticResource DividerBrush}" ShowsPreview="True"/>

        <!-- Bottom Pane -->
        <views:BottomView x:Name="BottomView" Grid.Column="2" Grid.Row="5"
                          Margin="0,0,3,3"
                          Background="{StaticResource BackgroundBrushDark}"
                          BorderThickness="0.8"/>

        <!-- Footer -->
        <Rectangle Grid.ColumnSpan="5" Grid.Row="6" Fill="{StaticResource FooterBrush}"/>

    </Grid>
</Window>
