<ResourceDictionary x:Class="HydroExplorer.Themes.ColorDict"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <!-- Primary Colors -->
    <Color x:Key="DividerColor">#1c1c1c</Color>
    <Color x:Key="BorderColor">#303030</Color>
    <Color x:Key="PrimaryColor">#B11904</Color>
    <Color x:Key="AccentColor">#B11904</Color>
    <Color x:Key="BackgroundColorButton">#3f3f46</Color>
    <Color x:Key="BackgroundColorTable">#3f3f46</Color>
    <Color x:Key="BackgroundColorDark">#202020</Color>
    <Color x:Key="BackgroundColorLight">#252526</Color>
    <Color x:Key="BackgroundColorTab">#262626</Color>
    <Color x:Key="BackgroundColor">#2d2d30</Color>
    <Color x:Key="ForegroundColorDark">#7B7B7B</Color>
    <Color x:Key="ForegroundColor">DarkGray</Color>
    <Color x:Key="FooterColor">#27324b</Color>

    <!-- Brushes (these are what you actually bind to in XAML) -->
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BackgroundBrushButton" Color="{StaticResource BackgroundColorButton}"/>
    <SolidColorBrush x:Key="BackgroundBrushTable" Color="{StaticResource BackgroundColorTable}"/>
    <SolidColorBrush x:Key="BackgroundBrushDark" Color="{StaticResource BackgroundColorDark}"/>
    <SolidColorBrush x:Key="BackgroundBrushLight" Color="{StaticResource BackgroundColorLight}"/>
    <SolidColorBrush x:Key="BackgroundBrushTab" Color="{StaticResource BackgroundColorTab}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="ForegroundBrushDark" Color="{StaticResource ForegroundColorDark}"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
    <SolidColorBrush x:Key="FooterBrush" Color="{StaticResource FooterColor}"/>
    <SolidColorBrush x:Key="LogoBrush" Color="{StaticResource FooterColor}"/>



    
    

</ResourceDictionary>